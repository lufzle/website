---
// Background component with procedural ambient gradient layer, CGA scanlines overlay, and WebGL2 fx canvas
---

<div id="bg-layer" style="position:fixed;inset:0;z-index:0;transition:opacity .4s"></div>
<div
  id="cga-scanlines"
  aria-hidden="true"
  style="position:fixed;inset:0;z-index:5;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.45) 0 1px,transparent 1px 3px),radial-gradient(ellipse at center,transparent 60%,rgba(0,0,0,.5) 100%);display:none"
></div>
<canvas
  id="fx-canvas"
  aria-hidden="true"
  style="position:fixed;inset:0;width:100vw;height:100vh;z-index:6;pointer-events:none;display:none"
></canvas>
