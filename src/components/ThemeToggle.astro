---
import { asLocale, useUi } from '../i18n/ui';

const copy = useUi(asLocale(Astro.currentLocale));
---

<button
  id="theme-toggle-btn"
  type="button"
  aria-label={copy.theme.toggle}
  title={copy.theme.hold}
  style="width:30px;height:30px;border-radius:50%;border:none;background:transparent;cursor:pointer;padding:0;overflow:hidden;position:relative;opacity:.85;transition:opacity .2s"
  class="theme-toggle-btn"
>
  <svg viewBox="0 0 30 30" width="30" height="30" style="display:block">
    <g id="theme-icon-moon">
      <circle cx="15" cy="15" r="5.5" fill="var(--fg)"></circle>
      <circle id="theme-icon-moon-cutout" cx="17.5" cy="13" r="4.6"></circle>
    </g>
    <g id="theme-icon-rays" stroke-width="2.2" stroke-linecap="round">
      <line x1="8" y1="19" x2="16" y2="11" stroke="#55FFFF"></line>
      <line x1="11" y1="22" x2="19" y2="14" stroke="#FF55FF"></line>
      <line x1="14" y1="25" x2="22" y2="17" stroke="#FFFF55"></line>
    </g>
    <g id="theme-icon-sun">
      <circle cx="15" cy="15" r="4.2" fill="var(--y)"></circle>
      <g stroke="var(--y)" stroke-width="1.2" stroke-linecap="round">
        <line x1="15" y1="7" x2="15" y2="8.8"></line><line x1="15" y1="21.2" x2="15" y2="23"></line>
        <line x1="7" y1="15" x2="8.8" y2="15"></line><line x1="21.2" y1="15" x2="23" y2="15"></line>
        <line x1="9.3" y1="9.3" x2="10.6" y2="10.6"></line><line x1="19.4" y1="19.4" x2="20.7" y2="20.7"></line>
        <line x1="9.3" y1="20.7" x2="10.6" y2="19.4"></line><line x1="19.4" y1="10.6" x2="20.7" y2="9.3"></line>
      </g>
    </g>
  </svg>
</button>

<style is:global>
  .theme-toggle-btn:hover {
    opacity: 1 !important;
  }

  #theme-icon-moon,
  #theme-icon-rays,
  #theme-icon-sun {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :root #theme-icon-moon,
  [data-theme='dark'] #theme-icon-moon {
    transform: translateY(0px);
  }
  [data-theme='light'] #theme-icon-moon,
  [data-theme='cga'] #theme-icon-moon {
    transform: translateY(-26px);
  }

  :root #theme-icon-sun,
  [data-theme='dark'] #theme-icon-sun,
  [data-theme='cga'] #theme-icon-sun {
    transform: translateY(26px);
  }
  [data-theme='light'] #theme-icon-sun {
    transform: translateY(0px);
  }

  :root #theme-icon-rays,
  [data-theme='dark'] #theme-icon-rays,
  [data-theme='light'] #theme-icon-rays {
    transform: translateY(26px);
  }
  [data-theme='cga'] #theme-icon-rays {
    transform: translateY(0px);
  }

  [data-theme='light'] #theme-icon-moon-cutout {
    fill: #f5f4f1;
  }
  :root #theme-icon-moon-cutout,
  [data-theme='dark'] #theme-icon-moon-cutout,
  [data-theme='cga'] #theme-icon-moon-cutout {
    fill: #111113;
  }
</style>
